# Settings for running CairnPost from source against the Compose database:
#   docker compose up -d postgres
#   set -a && . ./.env && set +a && go run ./cmd/cairnpost serve
CAIRNPOST_POSTGRES_DSN=postgres://cairnpost:cairnpost@localhost:5425/cairnpost?sslmode=disable
CAIRNPOST_DRIVER=capture
CAIRNPOST_ADDR=:8025

# To deliver for real, through Cloudflare Email Sending:
# CAIRNPOST_DRIVER=cloudflare
# CAIRNPOST_CLOUDFLARE_ACCOUNT_ID=
# CAIRNPOST_CLOUDFLARE_API_TOKEN=
# CAIRNPOST_CLOUDFLARE_QUEUE_ID=   # to read delivery events; the token then needs Queues too

# Settings for running CairnPost from source against the Compose database:
#   docker compose up -d postgres
#   set -a && . ./.env && set +a && go run ./cmd/cairnpost serve
CAIRNPOST_POSTGRES_DSN=postgres://cairnpost:cairnpost@localhost:5425/cairnpost?sslmode=disable
CAIRNPOST_DRIVER=capture
CAIRNPOST_ADDR=:8025

# To deliver for real, through Cloudflare Email Sending:
# CAIRNPOST_DRIVER=cloudflare
# CAIRNPOST_CLOUDFLARE_ACCOUNT_ID=
# CAIRNPOST_CLOUDFLARE_API_TOKEN=
# CAIRNPOST_CLOUDFLARE_QUEUE_ID=   # to read delivery events; the token then needs Queues too

# Webhooks to an application on this machine or a private network (plain
# http, private addresses) are refused unless this is set:
# CAIRNPOST_WEBHOOK_ALLOW_PRIVATE=on

# A webhook endpoint that has failed every try for 5 days is paused until it is
# resumed. Another time, or never:
# CAIRNPOST_WEBHOOK_PAUSE_AFTER=off

# An email's record is deleted after 30 days. To keep it longer, or for ever:
# CAIRNPOST_RETENTION=90d
# CAIRNPOST_RETENTION=off

# How many emails were sent each hour, and what became of them, is counted
# apart from the records and kept 62 days. To keep the numbers longer:
# CAIRNPOST_COUNTS_RETENTION=365d

# Nothing an email said is kept. To see what was sent while debugging, keep
# subjects and bodies for a short time (30d at most); admin keys can read them:
# CAIRNPOST_CONTENT_RETENTION=24h

# The console marks a sending domain when this share of its emails, in
# percent, bounced (5 unless set; off marks none):
# CAIRNPOST_BOUNCE_WARN=3

# The console says times in each browser's own time zone. For a browser
# that runs no scripts it is the system's, which TZ sets, or this:
# CAIRNPOST_CONSOLE_TIMEZONE=Europe/Berlin

# The console is at http://localhost:8025/console. Its session cookie needs
# https unless this is set, which is right only on your own machine:
CAIRNPOST_CONSOLE_PLAIN_HTTP=on

# A check of a domain's DNS may take 6 seconds. Where the first DNS server
# is slow to answer, give it longer:
# CAIRNPOST_DNS_TIMEOUT=15s
# It asks this machine's resolver. A home router's can make answers up; to
# ask a public DNS server instead:
# CAIRNPOST_DNS_SERVER=1.1.1.1
